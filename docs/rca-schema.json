{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/qa-ai-level3/rca-record.schema.json",
  "title": "RCA record (schema_version 1.2)",
  "description": "One record per failed or flaky test, written to reports/rca/rca-report.json. Classifications must cite artifacts; confidence is a calibrated judgement, not proof. v1.1 added console, network, DOM-snapshot and HEAD-diff evidence. v1.2 adds business severity, suggested owner, and downstream-symptom correlation.",
  "type": "object",
  "required": [
    "business_severity",
    "classification",
    "confidence",
    "detect",
    "evidence",
    "hypotheses",
    "recommended_action",
    "requires_human_approval",
    "scenario_id",
    "schema_version",
    "status",
    "suggested_owner",
    "symptom",
    "test_title",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^(AE|FI)-\\d+$|^UNKNOWN$"
    },
    "test_title": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "PRODUCT_DEFECT",
        "TEST_SCRIPT_DEFECT",
        "LOCATOR_OR_UI_CHANGE",
        "TEST_DATA_OR_STATE",
        "ENVIRONMENT_OR_NETWORK",
        "TIMING_OR_FLAKINESS",
        "THIRD_PARTY_DEPENDENCY",
        "UNKNOWN"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": ["HYPOTHESIS_PENDING_REVIEW"]
    },
    "symptom": {
      "type": "string",
      "maxLength": 300
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["classification", "confidence", "rule", "evidence_for", "evidence_against"],
        "properties": {
          "classification": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rule": {
            "type": "string"
          },
          "evidence_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_against": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "enum": ["error", "stack", "trace", "screenshot", "dom", "console", "network", "run", "diff"]
          },
          "path": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "requires_human_approval": {
      "const": true
    },
    "detect": {
      "type": "object",
      "required": ["run_url", "commit_sha", "collected_at"],
      "properties": {
        "run_url": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "business_severity": {
      "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW", "UNTRIAGED"],
      "description": "Scenario risk tier, reduced when the cause is not the product."
    },
    "suggested_owner": {
      "type": "string",
      "description": "Advisory first owner; the reviewer owns the final assignment."
    },
    "correlation": {
      "type": "object",
      "description": "Correlate stage: one event often fails many tests. The first failure of a signature is primary; the rest are downstream symptoms.",
      "required": ["signature", "primary", "group_size"],
      "properties": {
        "signature": {
          "type": "string"
        },
        "primary": {
          "type": "boolean"
        },
        "downstream_of": {
          "type": "string"
        },
        "group_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
