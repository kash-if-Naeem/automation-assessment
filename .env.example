# Copy to .env for local runs. Never commit .env (gitignored). CI uses repository secrets.

# Target environment (public practice site; keep worker count low)
BASE_URL=https://automationexercise.com
API_URL=https://automationexercise.com/api
PW_WORKERS=2

# Fault injection: leave empty for normal runs. Set to FI-02 to run the network fault suite.
FAULT_INJECTION=

# AI RCA (optional). Blank = model-free rule-based analysis (default; no adapter implemented yet).
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
